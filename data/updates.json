{
  "_about": {
    "what": "Years added after the Benefacts archive ends, from sources outside it.",
    "sign": "Expenditure is stored negative, matching the Benefacts convention.",
    "caution": "These figures come from the Charities Regulator's annual return, not from a full set of filed accounts. They are headline figures on the Regulator's own definitions and are not line-for-line comparable with the 182 fields Benefacts extracted. Where the two sources overlap they are not merged: the archive is left as it stands.",
    "grants": "Individual State grant awards announced after the archive ends, recorded one award per row exactly as the awarding body published them. An award is the amount announced, not money shown as received in any set of accounts, so grants are listed beside the accounts and never added into them."
  },
  "_sources": {
    "cra-ar": {
      "name": "Charities Regulator — annual reports",
      "url": "https://www.charitiesregulator.ie/media/yeia3rfc/charity-annual-reports.csv",
      "licence": "Open data, re-use of public sector information",
      "retrieved": "2026-11-11",
      "effective": "2026-05-03",
      "notes": "Bulk file. 83,051 annual report records. Employee and volunteer counts before 2021 are published as bands ('250-499') and are not used. From 2021 the Regulator collects full-time and part-time counts as integers; the employee figure here is their sum, a headcount, which is not the same measure as the average-employees figure in the Benefacts archive. Government funding is the sum of 'Income: Government or Local Authorities' and 'Income: Other Public Bodies', because charities reclassify between the two."
    },
    "dcedy-lgbti-2024": {
      "name": "Department of Children, Equality, Disability, Integration and Youth — 2024 LGBTI+ Community Services Funding Call",
      "url": "https://www.gov.ie/en/department-of-children-disability-and-equality/press-releases/24-projects-to-be-funded-under-the-2024-lgbti-community-services-funding-call-and-the-lgbti-youth-fund-2024/",
      "licence": "Re-use of public sector information",
      "published": "2024-12-20",
      "retrieved": "2026-11-13",
      "notes": "Press release announcing 24 projects: 15 under the 2024 LGBTI+ Community Services Funding Call (Scheme A €25,000–€100,000; Scheme B €5,000–€10,000) and 9 under the LGBTI+ Youth Fund 2024. Amounts are recorded to the cent as published."
    },
    "probation-ar-2024": {
      "name": "Probation Service — Annual Report 2024, Appendix 7",
      "url": "https://assets.gov.ie/static/documents/TAB_A_Probation_Service_Annual_Report_2024_FINAL.pdf",
      "licence": "Re-use of public sector information",
      "retrieved": "2026-11-16",
      "notes": "Appendix 7, 'Breakdown of funding streams for Community Based Organisations'. One row per organisation with three columns — Grant Funding, Additional Funding, Capital Funding — and a total; the table's own total is 'CBO Total Funding Spent in 2024', €18,951,340. Each column is recorded here as its own row. These are amounts the Probation Service reports as spent in the year, not awards announced in advance."
    },
    "probation-ar-2025": {
      "name": "Probation Service — Annual Report 2025, Appendix 8",
      "url": "https://assets.gov.ie/static/documents/2165b58d/Probation_Service_Annual_Report_2025.pdf",
      "licence": "Re-use of public sector information",
      "retrieved": "2026-11-16",
      "notes": "Appendix 8, 'Community Based Organisations & 2025 funding'. One figure per organisation, with no split into grant, additional and capital funding and no total row, so it is not on the same basis as the 2024 table. The appendix states that additional 2025 funding went to community organisations for extra expenditure, new pilot initiatives and new services, some of which may cover spending in 2026; that additional funding is not itemised by organisation."
    }
  },
