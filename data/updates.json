  "_about": {
    "what": "Years added after the Benefacts archive ends, from sources outside it.",
    "sign": "Expenditure is stored negative, matching the Benefacts convention.",
    "caution": "These figures come from the Charities Regulator's annual return, not from a full set of filed accounts. They are headline figures on the Regulator's own definitions and are not line-for-line comparable with the 182 fields Benefacts extracted. Where the two sources overlap they are not merged: the archive is left as it stands.",
    "grants": "Individual State grant awards announced after the archive ends, recorded one award per row exactly as the awarding body published them. An award is the amount announced, not money shown as received in any set of accounts, so grants are listed beside the accounts and never added into them."
  },
  "_sources": {
    "cra-ar": {
      "name": "Charities Regulator — annual reports",
